---
import Base from "./Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ImageLightbox from "../components/blog/ImageLightbox.astro";

interface Props {
  readonly frontmatter: {
    readonly title: string;
    readonly date: string;
    readonly tags: readonly string[];
  };
}

const { frontmatter } = Astro.props;

const formattedDate = new Date(frontmatter.date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Base title={`${frontmatter.title} | Josh Symonds`}>
  <Header />
  <main>
    <article class="prose">
      <header class="post-header">
        <h1>{frontmatter.title}</h1>
        <time datetime={frontmatter.date}>{formattedDate}</time>
        <div class="tags">
          {frontmatter.tags.map((tag) => (
            <span class="tag-pill">{tag}</span>
          ))}
        </div>
      </header>
      <slot />
    </article>
    <ImageLightbox />
  </main>
  <Footer />
</Base>

<style>
  .prose {
    max-width: 72ch;
    margin-inline: auto;
    padding-inline: 1.5rem;
    padding-block: 2rem;
    line-height: 1.75;
    color: var(--black);
  }

  .post-header {
    margin-block-end: 2.5rem;
    padding-block-end: 1.5rem;
    border-block-end: 3px solid var(--divider);
    position: relative;
  }

  .post-header::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -1.5px;
    width: 10px;
    height: 10px;
    background: var(--teal);
    border: 2px solid var(--divider);
    border-radius: 50%;
    transform: translate(-50%, 50%);
  }

  .post-header h1 {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 800;
    line-height: 1.2;
    margin-block-end: 0.75rem;
    color: var(--black);
  }

  .post-header time {
    display: block;
    color: var(--teal);
    font-size: 0.95rem;
    font-weight: 700;
    margin-block-end: 0.75rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag-pill {
    display: inline-block;
    padding: 0.2em 0.7em;
    border-radius: var(--radius-full);
    background: var(--bg-surface);
    color: var(--black);
    font-size: 0.8rem;
    font-weight: 500;
    border: 2px solid var(--black);
  }

  /* Prose content styles */
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    font-family: var(--font-heading);
    margin-block-start: 2em;
    margin-block-end: 0.75em;
    line-height: 1.3;
    color: var(--black);
  }

  .prose :global(h2) {
    font-size: 1.75rem;
  }

  .prose :global(h3) {
    font-size: 1.4rem;
  }

  .prose :global(h4) {
    font-size: 1.15rem;
  }

  .prose :global(a) {
    color: var(--teal);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.15em;
  }

  .prose :global(a:hover) {
    color: var(--coral);
  }

  .prose :global(pre) {
    background: var(--code-bg);
    border: 2px solid var(--black);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    overflow-x: auto;
    margin-block: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--black);
  }

  .prose :global(pre > code) {
    background: none;
    padding: 0;
    border: none;
    color: inherit;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .prose :global(:not(pre) > code) {
    background: var(--code-bg);
    padding: 0.15em 0.35em;
    border-radius: var(--radius-sm);
    border: 2px solid var(--black);
    color: var(--black);
  }

  .prose :global(blockquote) {
    border-inline-start: 4px solid var(--teal);
    padding-inline-start: 1.25rem;
    margin-inline: 0;
    margin-block: 1.5rem;
    background: var(--bg-surface-hover);
    padding: 1rem 1.25rem;
    color: var(--text-muted);
    font-style: italic;
    position: relative;
  }

  .prose :global(blockquote)::before {
    content: "";
    position: absolute;
    top: 0;
    left: -2px;
    width: 8px;
    height: 8px;
    background: var(--coral);
    border: 2px solid var(--divider);
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border: 2px solid var(--black);
    margin-block: 1.5rem;
  }

  .prose :global(.evidence) {
    margin: 2rem 0;
  }

  .prose :global(.evidence--wide) {
    width: min(92vw, 68rem);
    margin-inline-start: 50%;
    transform: translateX(-50%);
  }

  .prose :global(.evidence a) {
    display: block;
    cursor: zoom-in;
  }

  .prose :global(.evidence img) {
    margin: 0;
    background: white;
    box-shadow: 4px 4px 0 var(--black);
  }

  .prose :global(.evidence figcaption) {
    margin-top: 0.75rem;
    color: var(--text-muted);
    font-size: 0.85rem;
    font-style: italic;
  }

  .prose :global(.evidence-strip) {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(17rem, 21rem);
    align-items: start;
    gap: 1.25rem;
    overflow-x: auto;
    padding: 0.35rem 0.35rem 1rem;
    scroll-padding-inline: 0.35rem;
    scroll-snap-type: inline mandatory;
    scrollbar-color: var(--teal) var(--bg-surface-hover);
  }

  .prose :global(.evidence-strip a) {
    scroll-snap-align: start;
  }

  .prose :global(.evidence-strip img) {
    width: 100%;
  }

  .prose :global(.evidence--thread figcaption) {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .prose :global(.evidence--thread figcaption)::after {
    content: "Scroll →";
    flex: 0 0 auto;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-style: normal;
  }

  .prose :global(.evidence-pair) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 20rem));
    align-items: start;
    justify-content: center;
    gap: 1.25rem;
  }

  .prose :global(.evidence-pair img) {
    width: 100%;
  }

  @media (max-width: 600px) {
    .prose :global(.evidence-strip) {
      grid-auto-columns: 100%;
      gap: 0.75rem;
    }

    .prose :global(.evidence--thread figcaption) {
      flex-direction: column;
      gap: 0.25rem;
    }

    .prose :global(.evidence--thread figcaption)::after {
      align-self: flex-end;
    }

    .prose :global(.evidence-pair) {
      grid-template-columns: minmax(0, 21rem);
    }
  }

  .prose :global(.stat-callout) {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-block: 2rem;
    padding: 1.25rem 1.5rem;
    position: relative;
    background: var(--bg-surface);
    border: 3px solid var(--black);
    box-shadow: 5px 5px 0 var(--teal);
  }

  .prose :global(.stat-callout)::after {
    content: "";
    position: absolute;
    width: 10px;
    height: 10px;
    top: -6px;
    right: -6px;
    background: var(--coral);
    border: 2px solid var(--black);
    transform: rotate(45deg);
  }

  .prose :global(.stat-value) {
    flex-shrink: 0;
    color: var(--teal);
    font-family: var(--font-heading);
    font-size: clamp(2.75rem, 8vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 0.9;
  }

  .prose :global(.stat-label) {
    max-width: 28ch;
    color: var(--black);
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .prose :global(p) {
    margin-block: 1.25rem;
    max-width: none;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-inline-start: 1.5rem;
    margin-block: 1.25rem;
  }

  .prose :global(li) {
    margin-block: 0.35rem;
  }

  .prose :global(hr) {
    border: none;
    height: 3px;
    background: var(--divider);
    margin-block: 2rem;
    position: relative;
  }

  .prose :global(hr)::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 10px;
    height: 10px;
    background: var(--yellow);
    border: 2px solid var(--divider);
    border-radius: 50%;
  }

  /* Memphis-styled table */
  .prose :global(table) {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    border: 3px solid var(--black);
    box-shadow: 4px 4px 0 var(--black);
    background: var(--bg-surface);
    margin-block: 2rem;
    font-family: var(--font-body);
  }

  .prose :global(thead) {
    /* Soft tinted teal; full-strength --teal was too dark behind bold text. */
    background: color-mix(in srgb, var(--teal) 35%, var(--bg-surface));
  }

  .prose :global(th) {
    padding: 0.6rem 0.9rem;
    font-weight: 700;
    text-align: left;
    color: var(--black);
    border-bottom: 3px solid var(--black);
    border-right: 2px solid var(--black);
    font-family: var(--font-heading);
    letter-spacing: -0.01em;
  }
  .prose :global(th:last-child) {
    border-right: none;
  }

  .prose :global(td) {
    padding: 0.55rem 0.9rem;
    border-top: 2px solid var(--table-grid);
    border-right: 2px solid var(--table-grid);
    color: var(--black);
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }
  .prose :global(tr:first-child td) {
    border-top: none;
  }
  .prose :global(td:last-child) {
    border-right: none;
  }
  .prose :global(tbody tr:nth-child(even)) {
    background: var(--table-stripe);
  }

  .prose :global(td:first-child) {
    font-family: var(--font-body);
    font-weight: 500;
  }

  /* `**N MB**` in the source becomes <strong> inside a td -- render as a yellow pill */
  .prose :global(td strong) {
    display: inline-block;
    background: var(--yellow);
    padding: 0.05em 0.4em;
    border: 2px solid var(--black);
    box-shadow: 2px 2px 0 var(--black);
    color: var(--accent-ink);
    font-weight: 700;
    font-family: var(--font-mono);
    line-height: 1.2;
  }

  /* Memphis squiggle underline under section headings, tiled as a data-URI
     SVG so the wave keeps its aspect ratio regardless of heading width. */
  .prose :global(h2)::after {
    content: '';
    display: block;
    height: 0.45em;
    margin-top: 0.2em;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 220 14'><path d='M 0 7 Q 11 2 22 7 Q 33 12 44 7 Q 55 2 66 7 Q 77 12 88 7 Q 99 2 110 7 Q 121 12 132 7 Q 143 2 154 7 Q 165 12 176 7 Q 187 2 198 7 Q 209 12 220 7' fill='none' stroke='%232ec4b6' stroke-width='4' stroke-linecap='round'/></svg>");
    background-repeat: repeat-x;
    background-position: left center;
    background-size: auto 100%;
  }

  /* H3 shrinks to its text width so the squiggle sits tight under "The Dream"
     rather than spanning the whole column. */
  .prose :global(h3) {
    display: inline-block;
    max-width: 100%;
  }
  .prose :global(h3)::after {
    content: '';
    display: block;
    height: 0.38em;
    margin-top: 0.15em;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 220 14'><path d='M 0 7 Q 11 2 22 7 Q 33 12 44 7 Q 55 2 66 7 Q 77 12 88 7 Q 99 2 110 7 Q 121 12 132 7 Q 143 2 154 7 Q 165 12 176 7 Q 187 2 198 7 Q 209 12 220 7' fill='none' stroke='%23ffd166' stroke-width='3' stroke-linecap='round'/></svg>");
    background-repeat: repeat-x;
    background-position: left center;
    background-size: auto 100%;
  }

  /* Widget titles render their own <Squiggle>; suppress the prose rule there
     so we don't get a double underline. */
  .prose :global(.interactive-frame h3)::after {
    display: none;
  }
  .prose :global(.interactive-frame h3) {
    display: inline-block;
  }
</style>
