<dialog class="image-lightbox" aria-labelledby="image-lightbox-caption">
  <div class="lightbox-frame">
    <button class="lightbox-close" type="button" aria-label="Close expanded image">
      <span aria-hidden="true">×</span>
    </button>
    <div class="lightbox-viewport">
      <img class="lightbox-image" alt="" />
    </div>
    <p id="image-lightbox-caption" class="lightbox-caption"></p>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>(".image-lightbox");

  if (dialog && !dialog.dataset.ready) {
    dialog.dataset.ready = "true";

    const lightboxImage = dialog.querySelector<HTMLImageElement>(".lightbox-image");
    const caption = dialog.querySelector<HTMLElement>(".lightbox-caption");
    const closeButton = dialog.querySelector<HTMLButtonElement>(".lightbox-close");
    const frame = dialog.querySelector<HTMLElement>(".lightbox-frame");
    let trigger: HTMLAnchorElement | null = null;

    const close = () => {
      if (dialog.open) dialog.close();
    };

    document.querySelectorAll<HTMLAnchorElement>(".prose .evidence a").forEach((anchor) => {
      const sourceImage = anchor.querySelector<HTMLImageElement>("img");
      if (!sourceImage) return;

      anchor.addEventListener("click", (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        trigger = anchor;

        if (lightboxImage) {
          lightboxImage.src = anchor.href;
          lightboxImage.alt = sourceImage.alt;
        }

        if (caption) {
          const figureCaption = anchor.closest("figure")?.querySelector("figcaption");
          caption.textContent = figureCaption?.textContent?.trim() || sourceImage.alt;
        }

        dialog.showModal();
        document.documentElement.classList.add("lightbox-open");
        closeButton?.focus({ preventScroll: true });
      });
    });

    closeButton?.addEventListener("click", close);

    dialog.addEventListener("click", (event) => {
      if (!frame) return;
      const bounds = frame.getBoundingClientRect();
      const outside =
        event.clientX < bounds.left ||
        event.clientX > bounds.right ||
        event.clientY < bounds.top ||
        event.clientY > bounds.bottom;
      if (outside) close();
    });

    dialog.addEventListener("close", () => {
      document.documentElement.classList.remove("lightbox-open");
      lightboxImage?.removeAttribute("src");
      trigger?.focus({ preventScroll: true });
      trigger = null;
    });
  }
</script>

<style>
  .image-lightbox {
    width: min(96vw, 100rem);
    max-width: none;
    height: min(94vh, 80rem);
    max-height: none;
    margin: auto;
    padding: 0;
    overflow: visible;
    background: transparent;
    border: 0;
    color: var(--black);
  }

  .image-lightbox[open] {
    display: grid;
    place-items: center;
  }

  .image-lightbox::backdrop {
    background: rgb(10 12 16 / 88%);
    backdrop-filter: blur(5px);
  }

  .lightbox-frame {
    width: fit-content;
    max-width: 100%;
    max-height: 100%;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    position: relative;
    padding: 0.75rem;
    background: var(--bg-surface);
    border: 3px solid var(--black);
    box-shadow: 8px 8px 0 var(--coral);
  }

  .lightbox-viewport {
    min-height: 0;
    display: grid;
    place-items: center;
    overflow: auto;
    background: white;
  }

  .lightbox-image {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: calc(94vh - 7rem);
    object-fit: contain;
  }

  .lightbox-caption {
    max-width: 90ch;
    margin: 0.7rem 2.75rem 0 0;
    color: var(--text-muted);
    font-size: 0.85rem;
    font-style: italic;
    line-height: 1.35;
  }

  .lightbox-close {
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
    position: absolute;
    right: -0.85rem;
    top: -0.85rem;
    z-index: 1;
    padding: 0;
    background: var(--yellow);
    border: 3px solid var(--black);
    border-radius: 50%;
    box-shadow: 3px 3px 0 var(--coral);
    color: var(--accent-ink);
    cursor: pointer;
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 900;
    line-height: 1;
  }

  .lightbox-close:hover,
  .lightbox-close:focus-visible {
    background: var(--teal);
    outline: 3px solid var(--bg-page);
    outline-offset: 2px;
  }

  :global(html.lightbox-open) {
    overflow: hidden;
  }

  @media (max-width: 600px) {
    .lightbox-frame {
      padding: 0.4rem;
    }

    .lightbox-caption {
      margin: 0.6rem 2.25rem 0.15rem 0.15rem;
      font-size: 0.75rem;
    }
  }
</style>
