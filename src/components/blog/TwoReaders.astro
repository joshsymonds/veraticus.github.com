---
import data from '../../data/reddit-bigotry.json';

const ROWS = [
  { name: 'Antisemitism', key: 'antisemitism', bar: 'bar-a' },
  { name: 'Islamophobia', key: 'islamophobia', bar: 'bar-i' },
  { name: 'Anti-Black racism', key: 'antiblack', bar: 'bar-b' },
] as const;
const r = data.second_reader;
const pct = (a: number, b: number) => `${((a / b) * 100).toFixed(2)}%`;
const share = (a: number, b: number) => `${Math.round((a / b) * 100)}%`;
const decoys = ROWS.reduce((n, row) => n + r[row.key].decoys, 0);
const decoysCounted = ROWS.reduce((n, row) => n + r[row.key].decoys_counted, 0);
---

<figure class="readers" aria-label={`A second model, reading blind, also counted ${ROWS.map((row) => `${r[row.key].agreed} of the ${r[row.key].counted} ${row.name.toLowerCase()} comments the first model counted`).join(', ')}. It counted ${decoysCounted} of the ${decoys} ordinary comments mixed in with them.`}>
  <figcaption>
    <strong>Second reading</strong>
    <span>Comments Opus counted · the share GPT-6 Sol also counted</span>
  </figcaption>

  <div class="rows">
    {ROWS.map((row) => (
      <div class="row">
        <span class="label">{row.name}</span>
        <div class="track">
          <span class={`bar ${row.bar}`} style={`width:${pct(r[row.key].agreed, r[row.key].counted)}`}>
            <b>{r[row.key].agreed}</b>
          </span>
          <span class="rest"><b>{r[row.key].counted - r[row.key].agreed}</b></span>
        </div>
        <span class="total">{share(r[row.key].agreed, r[row.key].counted)}</span>
      </div>
    ))}
    <div class="keys">
      <span><i class="key kept"></i>Both count it</span>
      <span><i class="key rest"></i>Only Opus counts it</span>
    </div>
  </div>

  <div class="decoys">
    <strong>{decoysCounted} of {decoys}</strong>
    <span>ordinary comments, mixed in blind, that Sol counted as bigoted</span>
  </div>
</figure>

<style>
  .readers {
    margin: 2.25rem 0 2.5rem;
    background: var(--bg-surface);
    border: 3px solid var(--black);
    box-shadow: 6px 6px 0 var(--teal);
  }

  .readers figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding: 0.8rem 1rem;
    background: var(--black);
    color: var(--white);
  }

  .readers figcaption strong {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 800;
  }

  .readers figcaption span,
  .readers .label,
  .readers .keys,
  .readers .decoys span {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .readers .rows {
    display: grid;
    gap: 0.85rem;
    padding: 1.25rem 1rem 1.1rem;
  }

  .readers .row {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr) 3.25rem;
    align-items: center;
    gap: 0.75rem;
  }

  .readers .track {
    display: flex;
    height: 2.75rem;
    border: 3px solid var(--black);
  }

  .readers .bar,
  .readers .rest {
    display: flex;
    align-items: center;
    height: 100%;
    color: var(--accent-ink);
  }

  .readers .bar {
    border-right: 3px solid var(--black);
  }

  .readers .rest {
    flex: 1;
    color: var(--text-muted);
    background: repeating-linear-gradient(-45deg, transparent 0 7px, color-mix(in srgb, var(--text-muted) 22%, transparent) 7px 9px);
  }

  .readers .bar b,
  .readers .rest b {
    padding-left: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .readers .bar-a,
  .readers .key.kept {
    background: var(--coral);
  }

  .readers .bar-i {
    background: var(--teal);
  }

  .readers .bar-b {
    background: var(--yellow);
  }

  .readers .total {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 800;
    line-height: 1;
    text-align: right;
  }

  .readers .keys {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
    margin: -0.35rem 0 0.35rem calc(9.5rem + 0.75rem);
    color: var(--text-muted);
  }

  .readers .keys span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .readers .key {
    width: 0.9rem;
    height: 0.9rem;
    border: 2px solid var(--black);
  }

  .readers .key.kept {
    background: linear-gradient(90deg, var(--coral) 0 33%, var(--teal) 33% 66%, var(--yellow) 66%);
  }

  .readers .key.rest {
    background: repeating-linear-gradient(-45deg, var(--bg-surface) 0 3px, color-mix(in srgb, var(--text-muted) 40%, var(--bg-surface)) 3px 5px);
  }

  .readers .decoys {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.8rem;
    padding: 0.8rem 1rem;
    border-top: 3px solid var(--black);
  }

  .readers .decoys strong {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.2rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .readers .decoys span {
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .readers .row {
      grid-template-columns: minmax(0, 1fr) 3rem;
      grid-template-areas: 'label label' 'track total';
      gap: 0.3rem 0.6rem;
    }

    .readers .label {
      grid-area: label;
    }

    .readers .track {
      grid-area: track;
      height: 2.25rem;
    }

    .readers .total {
      grid-area: total;
    }

    .readers .keys {
      margin-left: 0;
    }
  }
</style>
